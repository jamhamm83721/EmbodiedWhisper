menu "EmbodiedWhisper network"
    config EW_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
    config EW_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
    config EW_SERVER_IPV4
        string "Receiving computer IPv4 address"
        default "192.0.2.1"
        help
            Replace this documentation address with your receiving computer's
            address on the same local network.
    config EW_SERVER_PORT
        int "Receiving computer TCP port"
        range 1 65535
        default 9090
endmenu
