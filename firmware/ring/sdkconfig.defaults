CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP32S3-Button"
# This project does not need external PSRAM. Keep it disabled to avoid
# boot failures when switching between ESP32-S3 variants/boards.
# CONFIG_SPIRAM is not set
